# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional overrides (defaults live in the instance/ folder)
# DATABASE_PATH=instance/pasameeso.sqlite
# UPLOAD_FOLDER=instance/uploads
# MAX_UPLOAD_MB=25

# Set to 1 in production, where the site is served over HTTPS
SESSION_COOKIE_SECURE=0
